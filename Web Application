<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Smart Revenue Recovery System</title>

<!-- EMAILJS -->
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>

<style>

/* =====================================================
   GENERAL
===================================================== */

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial, sans-serif;
}

body{
    background:#eef2f7;
    color:#172033;
}


/* =====================================================
   LOGIN SCREEN
===================================================== */

.login-screen{

    position:fixed;

    inset:0;

    background:linear-gradient(
        135deg,
        #111827,
        #1f2937
    );

    display:flex;

    justify-content:center;

    align-items:center;

    z-index:9999;
}


.login-box{

    width:420px;

    background:white;

    padding:40px;

    border-radius:18px;

    box-shadow:
        0 20px 50px rgba(0,0,0,.3);

}


.login-box h1{

    text-align:center;

    margin-bottom:10px;

    font-size:25px;

}


.login-box p{

    text-align:center;

    color:#64748b;

    margin-bottom:30px;

}


.login-box label{

    display:block;

    margin-top:15px;

    font-weight:bold;

}


.login-box input{

    width:100%;

    padding:13px;

    margin-top:7px;

    border:
        1px solid #cbd5e1;

    border-radius:8px;

    font-size:15px;

}


.login-btn{

    width:100%;

    padding:14px;

    margin-top:25px;

    background:#111827;

    color:white;

    border:none;

    border-radius:8px;

    font-size:16px;

    cursor:pointer;

}


.login-btn:hover{

    background:#374151;

}


.secondary-btn{

    background:#64748b;

}


.login-error{

    color:#dc2626;

    text-align:center;

    margin-top:15px;

    display:none;

    font-size:14px;

}


.otp-info{

    text-align:center;

    margin-top:15px;

    color:#475569;

    font-size:14px;

}


/* =====================================================
   HEADER
===================================================== */

header{

    height:75px;

    background:#111827;

    color:white;

    display:flex;

    align-items:center;

    justify-content:space-between;

    padding:0 35px;

}


header h1{

    font-size:24px;

}


header p{

    font-size:13px;

    color:#cbd5e1;

    margin-top:4px;

}


.header-right{

    text-align:right;

}


.login-user{

    color:#cbd5e1;

    font-size:13px;

    margin-bottom:5px;

}


.slide-number{

    font-size:18px;

    font-weight:bold;

}


/* =====================================================
   SLIDES
===================================================== */

.slide{

    display:none;

    min-height:
        calc(100vh - 145px);

    padding:45px;

}


.slide.active{

    display:block;

}


.slide-title{

    margin-bottom:30px;

}


.slide-title h2{

    font-size:30px;

    margin-bottom:8px;

}


.slide-title p{

    color:#64748b;

}


/* =====================================================
   MAIN CARD
===================================================== */

.main-card{

    background:white;

    border-radius:18px;

    padding:30px;

    box-shadow:
        0 8px 25px rgba(0,0,0,.08);

    max-width:1200px;

    margin:auto;

}


/* =====================================================
   NAVIGATION
===================================================== */

.navigation{

    height:70px;

    background:white;

    display:flex;

    justify-content:center;

    align-items:center;

    gap:30px;

    box-shadow:
        0 -5px 15px rgba(0,0,0,.06);

}


.navigation button{

    padding:11px 22px;

    border:none;

    border-radius:8px;

    background:#111827;

    color:white;

    cursor:pointer;

    font-size:14px;

}


.navigation button:hover{

    background:#374151;

}


.dots{

    display:flex;

    gap:8px;

}


.dot{

    width:10px;

    height:10px;

    background:#cbd5e1;

    border-radius:50%;

    cursor:pointer;

}


.dot.active{

    background:#111827;

}


/* =====================================================
   CSV UPLOAD
===================================================== */

.upload-area{

    border:
        3px dashed #94a3b8;

    padding:60px;

    text-align:center;

    border-radius:15px;

    background:#f8fafc;

}


.upload-area h2{

    margin-bottom:12px;

}


.upload-area p{

    color:#64748b;

    margin-bottom:20px;

}


.file-input{

    padding:12px;

}


.upload-status{

    margin-top:20px;

    font-weight:bold;

}


/* =====================================================
   TABLE
===================================================== */

.table-wrapper{

    overflow:auto;

    max-height:500px;

}


table{

    width:100%;

    border-collapse:collapse;

    background:white;

}


th,td{

    padding:13px;

    border-bottom:
        1px solid #e2e8f0;

    text-align:center;

    white-space:nowrap;

}


th{

    background:#111827;

    color:white;

}


tr:hover{

    background:#f8fafc;

}


/* =====================================================
   HEALTH SCORE
===================================================== */

.health{

    display:flex;

    justify-content:center;

    align-items:center;

    gap:80px;

    padding:40px;

}


.circle{

    width:220px;

    height:220px;

    border-radius:50%;

    background:#111827;

    color:white;

    display:flex;

    justify-content:center;

    align-items:center;

    flex-direction:column;

}


.circle strong{

    font-size:65px;

}


.circle span{

    font-size:18px;

}


.health-info{

    width:400px;

}


.health-info h2{

    margin-bottom:20px;

}


.progress{

    width:100%;

    height:14px;

    background:#e2e8f0;

    border-radius:10px;

    margin:
        8px 0 18px;

    overflow:hidden;

}


.progress div{

    height:100%;

    background:#111827;

    width:0%;

}


/* HEALTH PERCENTAGE LABELS */
.metric-label{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-top:8px;
    font-size:16px;
}

.metric-label strong{
    font-size:15px;
    font-weight:700;
}

/* =====================================================
   RISK
===================================================== */

.alert{

    padding:25px;

    border-radius:12px;

    margin-bottom:18px;

}


.alert h2,
.alert h3{

    margin-bottom:10px;

}


.alert p{

    margin-bottom:10px;

}


.red-alert{

    background:#fee2e2;

    border-left:
        6px solid #dc2626;

}


.yellow-alert{

    background:#fef3c7;

    border-left:
        6px solid #d97706;

}


.blue-alert{

    background:#dbeafe;

    border-left:
        6px solid #2563eb;

}


/* =====================================================
   PRODUCT HEALTH
===================================================== */

.product-grid{

    display:grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(220px,1fr)
        );

    gap:20px;

}


.product{

    border:
        1px solid #e2e8f0;

    border-radius:12px;

    padding:25px;

    text-align:center;

}


.product-score{

    font-size:50px;

    font-weight:bold;

    margin:15px 0;

}


.badge{

    padding:7px 14px;

    border-radius:20px;

    font-size:12px;

    font-weight:bold;

}


.green-badge{

    background:#dcfce7;

    color:#166534;

}


.yellow-badge{

    background:#fef3c7;

    color:#92400e;

}


.red-badge{

    background:#fee2e2;

    color:#991b1b;

}


/* =====================================================
   REGIONAL RISK
===================================================== */

.risk-high{

    color:#dc2626;

    font-weight:bold;

}


.risk-medium{

    color:#d97706;

    font-weight:bold;

}


.risk-low{

    color:#16a34a;

    font-weight:bold;

}


/* =====================================================
   RECOVERY
===================================================== */

.recovery-box{

    text-align:center;

}


.big-money{

    font-size:48px;

    font-weight:bold;

    margin:20px;

}


.recovery-grid{

    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:20px;

    margin:30px 0;

}


.money-card{

    background:#f8fafc;

    padding:25px;

    border-radius:12px;

}


.money-card strong{

    display:block;

    font-size:25px;

    margin-top:10px;

}


/* =====================================================
   SIMULATOR
===================================================== */

.simulator{

    max-width:850px;

}


.simulator select,
.investigation select{

    width:100%;

    padding:13px;

    margin:
        10px 0 25px;

    border:
        1px solid #cbd5e1;

    border-radius:8px;

}


.slider{

    margin:25px 0;

}


.slider label{

    display:flex;

    justify-content:space-between;

    margin-bottom:8px;

}


.slider input{

    width:100%;

}


.sim-grid{

    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:20px;

    margin-top:30px;

}


.sim-card{

    background:#f8fafc;

    padding:25px;

    border-radius:12px;

    text-align:center;

}


.sim-card strong{

    display:block;

    font-size:25px;

    margin-top:10px;

}


/* =====================================================
   ACTION CENTER
===================================================== */

.action{

    display:flex;

    align-items:center;

    gap:20px;

    padding:22px;

    border-bottom:
        1px solid #e2e8f0;

}


.action-icon{

    font-size:35px;

}


.action h3{

    margin-bottom:6px;

}


/* =====================================================
   INVESTIGATION
===================================================== */

.investigation{

    max-width:900px;

}


.detail-grid{

    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:15px;

    margin:25px 0;

}


.detail{

    background:#f8fafc;

    padding:20px;

    border-radius:10px;

    text-align:center;

}


.detail small{

    display:block;

    color:#64748b;

    margin-bottom:8px;

}


.detail strong{

    font-size:20px;

}


.explanation{

    margin-top:20px;

    background:#f8fafc;

    padding:25px;

    border-radius:12px;

}


.explanation h3{

    margin-bottom:15px;

}


/* =====================================================
   COMPLETED
===================================================== */

.completed{

    text-align:center;

    padding:70px;

}


.completed h1{

    margin-bottom:20px;

}


.completed p{

    color:#64748b;

    margin-bottom:30px;

}


/* =====================================================
   EXPORT REPORT
===================================================== */

.export-report{
    background:white;
    color:#172033;
    padding:25px;
}

.export-report .slide{
    display:block !important;
    min-height:auto;
    page-break-after:always;
    padding:25px 0;
}

.export-report .slide:last-child{
    page-break-after:auto;
}

.export-report .navigation,
.export-report .login-screen,
.export-report .login-btn{
    display:none !important;
}

.export-report header{
    position:static;
    margin-bottom:20px;
}

.export-report .main-card{
    box-shadow:none;
    border:1px solid #e2e8f0;
}

.export-report .table-wrapper{
    max-height:none;
    overflow:visible;
}

.export-report .slide-title{
    margin-bottom:15px;
}

@media print{
    .export-report .slide{
        page-break-after:always;
    }
}

/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:800px){

    .slide{

        padding:25px;

    }


    .health{

        flex-direction:column;

        gap:30px;

    }


    .health-info{

        width:100%;

    }


    .recovery-grid,
    .sim-grid,
    .detail-grid{

        grid-template-columns:1fr;

    }


    header{

        padding:0 15px;

    }


    header h1{

        font-size:17px;

    }


    .login-box{

        width:
            calc(100% - 30px);

    }

}



/* =====================================================
   SUPERTOKENS-STYLE DARK ORANGE THEME
===================================================== */
:root{
    --bg:#070707;
    --bg-soft:#0d0b09;
    --panel:#11100f;
    --panel-2:#15110e;
    --orange:#ff7a18;
    --orange-light:#ff9a45;
    --orange-dark:#c9560b;
    --text:#f4efe9;
    --muted:#aaa29b;
    --line:rgba(255,122,24,.22);
    --track:#2b2928;
}

html,body{
    background:
        radial-gradient(circle at 38% 25%, rgba(93,48,22,.55) 0%, rgba(48,29,21,.38) 24%, transparent 48%),
        radial-gradient(circle at 48% 75%, rgba(70,35,15,.32) 0%, transparent 38%),
        #070707 !important;
    color:var(--text) !important;
}

body{
    min-height:100vh;
}

header,
.top-header,
.app-header{
    background:rgba(10,9,8,.94) !important;
    color:var(--text) !important;
    border-bottom:1px solid rgba(255,255,255,.08) !important;
}

.login-screen{
    background:
        radial-gradient(circle at 35% 30%, rgba(93,48,22,.65), transparent 38%),
        radial-gradient(circle at 65% 70%, rgba(62,32,20,.35), transparent 42%),
        #070707 !important;
}

.login-box,
.main-card,
.card,
.panel,
.product-card,
.summary-card,
.analysis-card,
.content-card{
    background:rgba(16,14,13,.82) !important;
    color:var(--text) !important;
    border:1px solid var(--line) !important;
    box-shadow:0 18px 60px rgba(0,0,0,.35) !important;
}

.slide,
#application{
    background:transparent !important;
}

.slide-title h2,
h1,h2,h3,h4,
.metric-label,
.metric-label strong{
    color:var(--text) !important;
}

.slide-title p,
.login-box p,
.subtitle,
label{
    color:var(--muted) !important;
}

button,
.login-btn,
.secondary-btn,
.export-button,
.export-all-btn{
    background:linear-gradient(135deg,var(--orange),var(--orange-dark)) !important;
    color:#fff !important;
    border:1px solid var(--orange) !important;
    box-shadow:0 8px 24px rgba(255,122,24,.18) !important;
}

button:hover,
.login-btn:hover,
.secondary-btn:hover,
.export-button:hover,
.export-all-btn:hover{
    background:linear-gradient(135deg,#ff9140,var(--orange)) !important;
}

.navigation{
    background:rgba(10,9,8,.94) !important;
    border-color:rgba(255,255,255,.08) !important;
}

.dot{
    background:#4b4845 !important;
}

.dot.active{
    background:var(--orange) !important;
    box-shadow:0 0 12px rgba(255,122,24,.55) !important;
}

.progress{
    background:var(--track) !important;
}

.progress div{
    background:linear-gradient(90deg,var(--orange-dark),var(--orange-light)) !important;
}

.circle{
    background:
        radial-gradient(circle at center, #0b0a09 60%, transparent 61%),
        conic-gradient(var(--orange) 0deg, var(--orange-light) 250deg, #3a1c0b 250deg, #3a1c0b 360deg) !important;
    color:var(--text) !important;
    box-shadow:0 0 35px rgba(255,122,24,.25) !important;
}

.file-input,
input,
select,
textarea{
    border-color:rgba(255,122,24,.3) !important;
    background:#0d0c0b !important;
    color:var(--text) !important;
}

input::placeholder,
textarea::placeholder{
    color:#77716c !important;
}

.blue-alert,
.info-box,
.info-alert{
    background:rgba(255,122,24,.08) !important;
    border-color:rgba(255,122,24,.3) !important;
    color:var(--orange-light) !important;
}

.red-alert,
.yellow-alert,
.green-alert{
    background:rgba(20,17,15,.88) !important;
    border-color:rgba(255,122,24,.25) !important;
}

.export-all-btn{
    width:100%;
    padding:14px 18px;
    border-radius:10px;
    font-size:16px;
    font-weight:700;
    cursor:pointer;
}

/* Tables */
table{
    color:var(--text) !important;
}

th{
    background:rgba(255,122,24,.14) !important;
    color:var(--orange-light) !important;
    border-color:rgba(255,122,24,.2) !important;
}

td{
    border-color:rgba(255,255,255,.08) !important;
}

/* SuperTokens-style glow around major cards */
.main-card::before,
.card::before{
    border-color:rgba(255,122,24,.08) !important;
}

/* =====================================================
   EXPORT: SLIDES 2 TO 10 IN THREE PRINT PAGES
===================================================== */
.export-page{
    background:#070707 !important;
}

.export-slide{
    background:#070707 !important;
}

.export-slide .main-card{
    background:#11100f !important;
}

.export-slide .circle{
    background:#11100f !important;
}

.export-slide .progress{
    background:#2b2928 !important;
}

.export-slide .progress div{
    background:var(--orange) !important;
}

@media print{
    body{
        background:#070707 !important;
        -webkit-print-color-adjust:exact !important;
        print-color-adjust:exact !important;
    }
}

/* =========================================================
   FINAL SUPERTOKENS-STYLE UI — APPLY TO EVERY SLIDE
   ========================================================= */
:root{
  --sr-bg:#070707;
  --sr-bg2:#0d0a08;
  --sr-panel:#11100f;
  --sr-panel2:#17120f;
  --sr-orange:#ff7a18;
  --sr-orange2:#ff9a45;
  --sr-orange-dark:#b84c08;
  --sr-text:#f3eee8;
  --sr-muted:#a8a19b;
  --sr-line:rgba(255,122,24,.30);
  --sr-row:rgba(255,255,255,.025);
}

html,body{
  background:
    radial-gradient(circle at 28% 18%,rgba(101,51,20,.48) 0%,transparent 32%),
    radial-gradient(circle at 52% 42%,rgba(61,31,20,.30) 0%,transparent 38%),
    radial-gradient(circle at 30% 90%,rgba(84,39,14,.25) 0%,transparent 32%),
    #070707 !important;
  color:var(--sr-text) !important;
}

body{min-height:100vh;}

header{
  height:88px !important;
  padding:0 42px !important;
  background:rgba(10,9,8,.94) !important;
  border-bottom:1px solid rgba(255,122,24,.18) !important;
  box-shadow:0 8px 35px rgba(0,0,0,.35) !important;
}
header h1{color:#fff !important;font-size:25px !important;}
header p{color:#bdb5ae !important;}
.login-user{color:#c8c0b9 !important;}
.slide-number{color:#fff !important;}

#application,.slide{background:transparent !important;}
.slide{
  min-height:calc(100vh - 158px) !important;
  padding:42px 36px !important;
}

.slide-title{max-width:1400px;margin:0 auto 24px !important;}
.slide-title h2{
  color:var(--sr-text) !important;
  font-size:30px !important;
  letter-spacing:-.4px;
}
.slide-title h2::first-letter{color:var(--sr-orange);}
.slide-title p{color:var(--sr-muted) !important;font-size:15px;}

.main-card,
.login-box,
.product,
.money-card,
.simulator,
.investigation,
.alert{
  background:linear-gradient(145deg,rgba(25,17,13,.94),rgba(11,10,9,.97)) !important;
  color:var(--sr-text) !important;
  border:1px solid var(--sr-line) !important;
  box-shadow:0 18px 55px rgba(0,0,0,.42),inset 0 1px 0 rgba(255,255,255,.025) !important;
}
.main-card{
  max-width:1400px !important;
  border-radius:22px !important;
  padding:28px !important;
  position:relative;
  overflow:hidden;
}
.main-card::before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:radial-gradient(circle at 50% 0%,rgba(255,122,24,.08),transparent 42%);
}

/* ---------- TABLE: exactly the requested dark/orange look ---------- */
.table-wrapper{
  width:100% !important;
  max-height:520px !important;
  overflow:auto !important;
  background:#090909 !important;
  border:1px solid rgba(255,122,24,.48) !important;
  border-radius:16px !important;
  padding:10px !important;
  scrollbar-color:#a95013 #15110e;
  scrollbar-width:auto;
}
.table-wrapper::-webkit-scrollbar{width:12px;height:12px;}
.table-wrapper::-webkit-scrollbar-track{background:#14110f;border-radius:10px;}
.table-wrapper::-webkit-scrollbar-thumb{background:#9d4810;border-radius:10px;border:2px solid #14110f;}
.table-wrapper::-webkit-scrollbar-thumb:hover{background:#ff7a18;}

table{
  width:100% !important;
  min-width:900px;
  border-collapse:separate !important;
  border-spacing:0 !important;
  background:#090909 !important;
  color:#dfe4eb !important;
}
th{
  position:sticky;top:0;z-index:2;
  background:linear-gradient(90deg,#2b170b,#19110d) !important;
  color:#ff8a2d !important;
  font-weight:700 !important;
  font-size:15px !important;
  padding:15px 14px !important;
  text-align:left !important;
  border-bottom:1px solid rgba(255,122,24,.34) !important;
}
td{
  background:#090909 !important;
  color:#d8e0ea !important;
  font-size:14px !important;
  padding:14px !important;
  border-bottom:1px solid rgba(255,255,255,.055) !important;
  white-space:nowrap;
}
tbody tr:nth-child(even) td{background:#12100f !important;}
tbody tr:hover td{background:rgba(255,122,24,.10) !important;color:#fff !important;}

/* ---------- Business Health ---------- */
.health{gap:90px !important;padding:42px !important;}
.circle{
  background:
    radial-gradient(circle,#0a0908 63%,transparent 64%),
    conic-gradient(var(--sr-orange) 0deg,var(--sr-orange2) 250deg,#3b1b0a 250deg,#3b1b0a 360deg) !important;
  color:#fff !important;
  box-shadow:0 0 38px rgba(255,122,24,.22) !important;
  border:2px solid rgba(255,122,24,.16);
}
.circle strong{color:#fff !important;}
.circle span{color:#fff !important;}
.health-info h2{color:#fff !important;}
.metric-label{color:#eee6df !important;}
