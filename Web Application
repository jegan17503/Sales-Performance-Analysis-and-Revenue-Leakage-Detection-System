function createProductHealth(){

    const container =
        document
        .getElementById(
            "productHealth"
        );


    container.innerHTML = "";


    Object.keys(products)
    .forEach(
        name=>{


            const p =
                products[name];


            const avgDiscount =
                p.discount /
                p.orders;


            const returnRate =
                p.returns /
                Math.max(
                    1,
                    p.quantity
                );


            const risk =

                avgDiscount *
                100 *
                .8

                +

                returnRate *
                100

                +

                (
                    p.stock /
                    Math.max(
                        1,
                        p.revenue
                    )
                ) *
                1000;


            let score =
                100 - risk;


            score =
                Math.max(
                    0,
                    Math.min(
                        100,
                        score
                    )
                );


            score =
                Math.round(score);


            let status;

            let cls;


            if(score >= 75){

                status =
                    "HEALTHY";

                cls =
                    "green-badge";

            }

            else if(score >= 50){

                status =
                    "WARNING";

                cls =
                    "yellow-badge";

            }

            else{

                status =
                    "CRITICAL";

                cls =
                    "red-badge";

            }


            const div =
                document
                .createElement("div");


            div.className =
                "product";


            div.innerHTML = `

                <h3>
                    ${escapeHTML(name)}
                </h3>

                <div class="product-score">
