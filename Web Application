        );

    }


    if(
        explanation.length === 0
    ){

        explanation.push(
            "✓ No major leakage indicator detected for this product."
        );

    }


    document
    .getElementById(
        "explanation"
    )
    .innerHTML =
        explanation.join(
            "<br><br>"
        );

}


