/* =====================================================
   WHAT-IF SIMULATOR
===================================================== */

function updateSimulator(){

    const product =
        document
        .getElementById(
            "simProduct"
        )
        .value;


    if(!product){

        return;

    }


    const p =
        products[product];


    if(!p){

        return;

    }


    const discount =
        Number(
            document
            .getElementById(
                "discountSlider"
            )
            .value
        );


    const returns =
        Number(
            document
            .getElementById(
                "returnsSlider"
            )
            .value
        );


    const stock =
        Number(
            document
            .getElementById(
                "stockSlider"
            )
            .value
        );


    document
    .getElementById(
        "discountDisplay"
    )
    .innerText =
        discount + "%";


    document
    .getElementById(
        "returnsDisplay"
    )
    .innerText =
        returns;


    document
    .getElementById(
        "stockDisplay"
    )
    .innerText =
        money(stock);


    const currentDiscount =
        p.discount /
        p.orders;


    let current = 0;


    if(
        currentDiscount >
        0.15
    ){

        current +=
            p.revenue *
            (
                currentDiscount -
                0.15
            );

    }


    current +=
        p.returns *
        p.price *
        (
            1 -
            currentDiscount
        );


    current +=
        p.stock;


    const gross =
        p.quantity *
        p.price;


    let simulatedDiscount =
        0;


    if(
        discount > 15
    ){

        simulatedDiscount =
            gross *
            (
                discount / 100 -
                0.15
            );

    }


    const simulatedReturn =
        returns *
        p.price *
        (
            1 -
            discount / 100
        );


    const simulated =
        simulatedDiscount +
        simulatedReturn +
        stock;


    const recovery =
        Math.max(
            0,
            current -
            simulated
        );


    document
    .getElementById(
        "currentLeak"
    )
    .innerText =
        money(current);


    document
    .getElementById(
        "simulatedLeak"
    )
    .innerText =
        money(simulated);


    document
    .getElementById(
        "simRecovery"
    )
    .innerText =
        money(recovery);

}


