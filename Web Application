/* =====================================================
   HTML ESCAPE
===================================================== */

function escapeHTML(value){

    return value
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


/* =====================================================
   DATA ANALYSIS
===================================================== */

function analyzeData(){

    products = {};

    regions = {};

    discountLoss = 0;

    returnLoss = 0;

    stockLoss = 0;

    totalRevenue = 0;


    salesData.forEach(
        row=>{


            const quantity =
                Number(
                    row.Quantity
                ) || 0;


            const price =
                Number(
                    row.Price
                ) || 0;


            const discount =
                Number(
                    row.Discount
                ) || 0;


            const returns =
                Number(
                    row.Returns
                ) || 0;


            const stock =
                Number(
                    row.StockLoss
                ) || 0;


            const gross =
                quantity * price;


            const revenue =
                gross *
                (1 - discount);


            totalRevenue +=
                revenue;


            /* DISCOUNT LEAKAGE */

            if(
                discount > 0.15
            ){

                discountLoss +=
                    gross *
                    (discount - 0.15);

            }


            /* RETURN LEAKAGE */

            returnLoss +=
                returns *
                price *
                (1 - discount);


            /* STOCK LEAKAGE */

            stockLoss +=
                stock;


            /* PRODUCT */

            const product =
                row.Product ||
                "Unknown";


            if(
                !products[product]
            ){

                products[product] = {

                    revenue:0,

                    quantity:0,

                    returns:0,

                    discount:0,

                    stock:0,

                    orders:0,

                    price:price

                };

            }


            products[product]
                .revenue +=
                revenue;


            products[product]
                .quantity +=
                quantity;


            products[product]
                .returns +=
                returns;


            products[product]
                .discount +=
                discount;


            products[product]
                .stock +=
                stock;


            products[product]
                .orders++;


            /* REGION */

            const region =
                row.Region ||
                "Unknown";


            if(
                !regions[region]
            ){

                regions[region] = {

                    revenue:0,

                    leakage:0

                };

            }


            regions[region]
                .revenue +=
                revenue;


            regions[region]
                .leakage +=

                returns *
                price *
                (1 - discount)

                +

                stock;

        }
    );

}


/* =====================================================
   BUSINESS HEALTH
===================================================== */

function createHealth(){

    if(
        totalRevenue <= 0
    ){

        return;

    }


    const totalLeakage =
        discountLoss +
        returnLoss +
        stockLoss;


    const ratio =
        (
            totalLeakage /
            totalRevenue
        ) * 100;


    let score =
        100 -
        ratio * 3;


    score =
        Math.max(
            0,
            Math.min(
                100,
                score
            )
        );


    score =
        Math.round(score);


    const revenueStability =
        Math.min(100, score + 10);

    const leakageControl =
        Math.max(5, 100 - ratio * 5);

    const operationalEfficiency =
        score;

    document
    .getElementById("healthScore")
    .innerText =
        score + "%";

    document
    .getElementById("revenuePercent")
    .innerText =
        Math.round(revenueStability) + "%";

    document
    .getElementById("leakagePercent")
    .innerText =
        Math.round(leakageControl) + "%";

    document
    .getElementById("efficiencyPercent")
    .innerText =
        Math.round(operationalEfficiency) + "%";


    let status;


    if(score >= 80){

        status =
            "Healthy Business";

    }

    else if(score >= 60){

        status =
            "Needs Attention";

    }

    else{

        status =
            "Critical Business Risk";

    }


    document
    .getElementById("healthStatus")
    .innerText =
        status;


    document
    .getElementById("revenueBar")
    .style.width =
        revenueStability + "%";


    document
    .getElementById("leakageBar")
    .style.width =
        leakageControl + "%";


    document
    .getElementById("efficiencyBar")
    .style.width =
        operationalEfficiency + "%";

}


